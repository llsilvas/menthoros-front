# Porta exposta no host para o frontend
# Local (Dockerfile.local): padrão 5173
# Cloud (Dockerfile.cloud): padrão 80
# FRONT_PORT=3000

# URL base da API (opcional — sobrescrito via environment no docker-compose)
# Deixe vazio para usar o proxy nginx (/api) ou informe URL completa para acesso direto
# VITE_API_BASE_URL=http://localhost:8099

# URL interna do backend para o proxy reverso nginx (Dockerfile.cloud)
# Docker local: http://menthoros-app:8080 (padrão — rede menthoros-network)
# Railway:      http://pacific-renewal.railway.internal:8080 (private network)
# BACKEND_URL=http://menthoros-app:8080

# Keycloak — provedor de identidade (autenticação via Direct Grant)
# URL usada no browser: usa proxy do Vite (/auth) para evitar CORS
# VITE_KEYCLOAK_URL=/auth
# URL real do Keycloak usada pelo proxy do Vite
# Railway (dev): https://menthoros-keycloak-develop.up.railway.app
# Local Docker: http://localhost:8080
# KEYCLOAK_URL=https://menthoros-keycloak-develop.up.railway.app
# Realm do Keycloak (conforme configurado com backend)
# VITE_KEYCLOAK_REALM=menthoros
# Client registrado no realm para autenticação frontend
# VITE_KEYCLOAK_CLIENT_ID=menthoros-web
