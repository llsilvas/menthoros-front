# Porta exposta no host para o frontend
# Local (Dockerfile.local): padrão 5173
# Cloud (Dockerfile.cloud): padrão 80
# FRONT_PORT=3000

# URL base da API (opcional — sobrescrito via environment no docker-compose)
# Deixe vazio para usar o proxy nginx (/api) ou informe URL completa para acesso direto
# VITE_API_BASE_URL=http://localhost:8099
