server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Resolver extraído de /etc/resolv.conf em runtime pelo docker-entrypoint.sh
    # Adia a resolução DNS para o momento da requisição (evita falha no startup
    # quando o hostname do backend ainda não está disponível no DNS)
    resolver __DNS_RESOLVER__ valid=10s ipv6=on;

    # Cache imutável para assets com hash de conteúdo (Vite: /assets/main.a1b2c3.js)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # env-config.js: NUNCA cachear (modificado a cada startup do container)
    location = /env-config.js {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Proxy reverso para o Keycloak
    # /auth/realms/... → __KEYCLOAK_URL__/realms/...  (strip do prefixo /auth)
    # Evita CORS no browser — mesmo padrão do proxy Vite em dev
    location /auth/ {
        set $keycloak "__KEYCLOAK_URL__";
        rewrite ^/auth/(.*) /$1 break;
        proxy_pass $keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Proxy reverso para o backend Spring Boot
    # /api/atleta → __BACKEND_URL__/atleta  (strip do prefixo /api)
    # Elimina CORS: o browser acessa apenas a própria origem
    # set $upstream adia a resolução DNS — nginx sobe mesmo se o backend não estiver pronto
    location /api/ {
        set $upstream "__BACKEND_URL__";
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }

    # SPA fallback (hash routing já trata rotas no cliente, mas é boa prática)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
