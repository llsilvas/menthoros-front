server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Cache imutável para assets com hash de conteúdo (Vite: /assets/main.a1b2c3.js)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # env-config.js: NUNCA cachear (modificado a cada startup do container)
    location = /env-config.js {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Proxy reverso para o backend Spring Boot
    # /api/atleta → ${BACKEND_URL}/atleta  (strip do prefixo /api)
    # Elimina CORS: o browser acessa apenas a própria origem
    # ${BACKEND_URL} é substituído em runtime pelo docker-entrypoint.sh via envsubst
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }

    # SPA fallback (hash routing já trata rotas no cliente, mas é boa prática)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
